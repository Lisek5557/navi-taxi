<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent"
            android:text="@string/scan_qr"
            android:textColor="@android:color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scan_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/Label"
            android:text="@string/server_url" />

        <EditText
            android:id="@+id/serverInput"
            style="@style/Field"
            android:hint="https://xxxx.trycloudflare.com"
            android:inputType="textUri" />

        <TextView
            style="@style/Label"
            android:text="@string/api_key" />

        <EditText
            android:id="@+id/keyInput"
            style="@style/Field"
            android:inputType="textVisiblePassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="@string/test_connection" />

        <TextView
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <!-- Korporacja (cennik i rabaty) -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="28dp"
            android:text="Kod korporacji (cennik i rabaty)"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/corpInput"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="np. zt19622"
                android:inputType="textVisiblePassword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/corpButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:text="Sprawdź" />
        </LinearLayout>

        <TextView
            android:id="@+id/corpInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kod dostaniesz od swojej korporacji. Bez kodu aplikacja nie pokazuje cen."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Konto kierowcy -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="28dp"
            android:text="Twoje konto (zgłoszenia na mapie, ograniczenia prędkości)"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/accountInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/registerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/nameInput"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Imię albo kod kierowcy"
                android:inputType="textPersonName" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:text="Załóż konto" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Admin: zgłoszenia do zatwierdzenia"
            android:visibility="gone" />

        <!-- Mapa offline -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="28dp"
            android:text="Mapa offline (bez zasięgu)"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/offlineInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kujawsko-pomorskie, ok. 150–300 MB. Pobieraj przez Wi-Fi. Trasy nadal liczy serwer."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/offlineButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="Pobierz mapę offline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/offlineDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Usuń" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF3A404C"
            android:text="@string/save"
            android:textColor="@color/text"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
