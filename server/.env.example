# Skopiuj do pliku .env (start.ps1 zrobi to za Ciebie i wygeneruje API_TOKEN).

# Hasło, które wpisujesz w aplikacji (Ustawienia -> Klucz API). Serwer jest w internecie!
API_TOKEN=

# Klucz panelu admina (admin.bat). Tylko na komputerze z serwerem — NIE dawaj kierowcom.
ADMIN_TOKEN=

# Darmowy klucz: https://developer.tomtom.com -> Dashboard -> Keys.
# Bez klucza nawigacja działa, ale bez korków.
TOMTOM_API_KEY=

# Reguła "najkrótszej rozsądnej": najkrótsza trasa, która jest wolniejsza od
# najszybszej maksymalnie o X % i maksymalnie o Y sekund.
ROUTE_TOLERANCE_PCT=10
ROUTE_MAX_EXTRA_SEC=180
